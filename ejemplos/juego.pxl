// Programa del minijuego de Unity: el caballero que controla el jugador y el slime enemigo.
// Los dos personajes se compilan juntos en una sola biblioteca (pixellang.dll). Cada uno
// tiene 64 instancias con su propia ficha; la instancia n del personaje p es el número
// p + 2·n. El juego les envía los eventos con pl_evento(instancia, evento): 0 es el
// caballero y 1 y 3, los dos slimes del minijuego.

personaje Caballero {
    vida: entero = 100;
    daño_golpe: entero = 25;
    velocidad: real = 0.0;
    y: real = 0.0;

    eventos saltar, atacar, aterrizar, fin_ataque, recibir_golpe, fin_aturdimiento;

    inicial estado Reposo {
        al_entrar { velocidad = 0.0; y = 0.0; }
        cuando saltar -> Saltando;
        cuando atacar -> Atacando;
        cuando recibir_golpe -> Aturdido;
    }

    estado Saltando {
        al_entrar { y = y + 2.5; }
        cuando aterrizar -> Reposo;
        cuando recibir_golpe -> Aturdido;
    }

    estado Atacando {
        al_entrar {
            si vida < 50 { velocidad = 1.0; } sino { velocidad = 1.5; }
        }
        cuando fin_ataque -> Reposo;
        cuando recibir_golpe -> Aturdido;
    }

    estado Aturdido {
        al_entrar { vida = vida - daño_golpe; velocidad = 0.0; }
        cuando recibir_golpe -> Aturdido;
        cuando fin_aturdimiento si vida <= 0 -> Derrotado;
        cuando fin_aturdimiento -> Reposo;
    }

    final estado Derrotado {
        al_entrar { vida = 0; }
    }
}

personaje Slime {
    vida: entero = 30;
    daño_golpe: entero = 10;

    eventos ver_jugador, perder_jugador, recibir_golpe, fin_aturdimiento;

    inicial estado Patrulla {
        cuando ver_jugador -> Persecucion;
        cuando recibir_golpe -> Aturdido;
    }

    estado Persecucion {
        cuando perder_jugador -> Patrulla;
        cuando recibir_golpe -> Aturdido;
    }

    estado Aturdido {
        al_entrar { vida = vida - daño_golpe; }
        cuando recibir_golpe -> Aturdido;
        cuando fin_aturdimiento si vida <= 0 -> Aplastado;
        cuando fin_aturdimiento -> Persecucion;
    }

    final estado Aplastado {
        al_entrar { vida = 0; }
    }
}

simular Caballero: saltar, aterrizar, atacar, fin_ataque,
                   recibir_golpe, recibir_golpe, recibir_golpe, fin_aturdimiento,
                   atacar, fin_ataque, recibir_golpe, fin_aturdimiento;

simular Slime: ver_jugador, recibir_golpe, fin_aturdimiento,
               recibir_golpe, recibir_golpe, fin_aturdimiento;
