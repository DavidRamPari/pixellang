{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generar parser (ANTLR)",
      "type": "shell",
      "command": "java",
      "args": [
        "-jar", "antlr-4.13.2-complete.jar",
        "-Dlanguage=Python3", "-visitor", "-no-listener",
        "-o", "src/generado", "-Xexact-output-dir",
        "gramatica/PixelLang.g4"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
